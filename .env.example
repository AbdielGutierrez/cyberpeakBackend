# Variables de entorno del backend (NO subir un archivo .env real).
# En Render se configuran en Dashboard > Environment.
# El código NO carga archivos .env automáticamente; estas variables
# deben existir en el entorno del proceso.

# Clave para firmar los JWT. En producción usa un valor aleatorio largo.
CYBERPEAK_SECRET_KEY=cambia-esto-por-un-valor-aleatorio

# Orígenes permitidos por CORS, separados por coma (dominio del frontend).
CYBERPEAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Duración del token en minutos (opcional, por defecto 60).
# CYBERPEAK_ACCESS_TOKEN_MINUTES=60

# Ruta de la base SQLite (opcional, por defecto db/northwind.db).
# CYBERPEAK_DB_PATH=db/northwind.db
